# GEMINI_API_KEY: Required for the /api/parse-resume route to call the Gemini API.
# Copy this file to .env.local and fill in your key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase project credentials (Project Settings -> API Keys in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL="MY_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# Secret key: server-only, bypasses Row Level Security. Never expose this to
# the browser or prefix it with NEXT_PUBLIC_. Used by scripts/seed.ts and the
# Stripe webhook (lib/supabase/service.ts).
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"

# Stripe (Dashboard -> Developers -> API keys / Webhooks). Test-mode keys
# while developing. The webhook secret comes from either the Dashboard's
# webhook endpoint (pointed at /api/stripe/webhook) or
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally.
#
# Create these 6 Products/Prices in the Stripe Dashboard (EUR):
#   Independent Learner (Starter)        one-time    EUR 17.00
#   Job Ready Simulator — Founding       one-time    EUR 34.00  (first 150 buyers only)
#   Job Ready Simulator — Regular        one-time    EUR 52.00
#   Stay Employed (Career Accelerator)   recurring   EUR 35.00 / month
#   AI Credit Pack A                     one-time    EUR 5.00
#   AI Credit Pack B                     one-time    EUR 9.00
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="MY_STRIPE_WEBHOOK_SECRET"
STRIPE_PRICE_STARTER="MY_STRIPE_PRICE_ID"
STRIPE_PRICE_PROFESSIONAL_FOUNDING="MY_STRIPE_PRICE_ID"
STRIPE_PRICE_PROFESSIONAL_REGULAR="MY_STRIPE_PRICE_ID"
STRIPE_PRICE_ACCELERATOR_MONTHLY="MY_STRIPE_PRICE_ID"
STRIPE_PRICE_CREDIT_PACK_A="MY_STRIPE_PRICE_ID"
STRIPE_PRICE_CREDIT_PACK_B="MY_STRIPE_PRICE_ID"
